# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.app/

# Environment / local config
.env
.env.*
!.env.example
.server-port
.local-session

# User data (DB & uploads should NOT be committed)
server/clockwize.db
server/clockwize.db-journal
server/clockwize.db-wal
server/clockwize.db-shm
server/clockwize.db.lock
*.db.lock
server/uploads/*
!server/uploads/.gitkeep
backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.cursor/
.idea/
*.swp
*.swo

# Tooling/cache
.claude/
.cache/
coverage/

# Local backups (e.g. old git history backup)
.git.old-private-backup/
.git.backup*/

# Playwright e2e output (the e2e server's data lives in the OS temp dir)
playwright-report/
test-results/
blob-report/
playwright/.cache/

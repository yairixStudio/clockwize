# Copy this file to server/.env and fill in real values before running the server.
# Generate each secret with:  openssl rand -hex 32

# Signs the JWT auth tokens. Changing it logs everyone out. Min 32 chars.
JWT_SECRET=

# Derives the AES-256-GCM keys for credentials and addon secrets (OpenAI API key etc.).
# Min 32 chars. On first boot with a new value the server automatically re-encrypts
# data that was still encrypted with the old built-in secret - keep a DB backup first.
ENCRYPTION_SECRET=

# Optional - API port (defaults to 3000, and auto-increments if the port is busy)
# PORT=3000

# Optional - WebAuthn (passkeys). Defaults fit local development (localhost).
# For production set the site's domain and full origin(s):
# RP_ID=app.example.com
# RP_ORIGINS=https://app.example.com
